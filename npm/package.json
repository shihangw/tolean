{
  "name": "tolean",
  "version": "0.3.0",
  "license": "Apache-2.0",
  "description": "Translate a subset of TypeScript, Go and PostgreSQL to Lean 4, so proofs are about the real source",
  "keywords": [
    "lean",
    "lean4",
    "formal-verification",
    "theorem-proving",
    "typescript",
    "go",
    "postgresql",
    "sqlc"
  ],
  "homepage": "https://shihangw.github.io/tolean/docs/",
  "bugs": {
    "url": "https://github.com/shihangw/tolean/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shihangw/tolean.git",
    "directory": "npm"
  },
  "bin": {
    "tolean": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "lean"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copyFromRoot.ts",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "vitest": "3.2.7",
    "typescript": "6.0.3"
  }
}
